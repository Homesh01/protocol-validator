{
	"name": "protocol-validator",
	"compatibility_date": "2025-07-18",
	"main": "./server.ts",
	"assets": {
		"directory": "./build/client"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"kv_namespaces": [
		{
			"binding": "AUTH_KV",
			"id": "075f18747fe34a24bbc855dc9c16b761"
		}
	],
	"r2_buckets": [
		{
			"binding": "VALIDATION_R2",
			"bucket_name": "protocol-validator-validation"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "VALIDATION_QUEUE",
				"queue": "protocol-validator-pipeline"
			}
		],
		"consumers": [
			{
				"queue": "protocol-validator-pipeline",
				"max_batch_size": 1,
				"max_batch_timeout": 0,
				"max_retries": 3
			}
		]
	}
}